// ============================================================================
// 6. SERVICES
// (numbered per the design doc; placed here since WORKS references it)
// ============================================================================

model Service {
  id            Int      @id @default(autoincrement())
  name          String
  defaultCharge Float    @map("default_charge")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById Int?      @map("deleted_by")
  deletedBy   User?     @relation("ServiceDeletedByUser", fields: [deletedById], references: [id])

  works Work[]

  @@map("services")
}
