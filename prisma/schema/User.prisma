// ============================================================================
// 1. USERS
// ============================================================================
// NOTE: Prisma's SQLite connector does not support `enum` blocks, so the
// CHECK-constrained columns from the design doc are plain String fields
// here. Enforce the allowed values at the application layer (e.g. a TS
// union type / zod enum) and, if you want a DB-level guarantee, add a
// `CHECK (role IN ('ADMIN','STAFF'))` via a manual migration.
// Valid values for `role`: "ADMIN" | "STAFF"

model User {
  id           Int      @id @default(autoincrement())
  userId       String   @unique @map("user_id")
  name         String
  passwordHash String   @map("password_hash")
  role         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Self-relation: which admin soft-deleted this user.
  // App layer must enforce: only ADMIN role may set this on a STAFF user.
  deletedById Int?  @map("deleted_by")
  deletedBy   User? @relation("UserDeletedByUser", fields: [deletedById], references: [id])
  usersDeleted User[] @relation("UserDeletedByUser")

  // Reverse relations from every other table that references users.id
  activityLogs        ActivityLog[]  @relation("ActivityLogUser")
  activityLogsDeleted  ActivityLog[]  @relation("ActivityLogDeletedByUser")
  loginSessions        LoginSession[]
  customersDeleted     Customer[]     @relation("CustomerDeletedByUser")
  worksCreated         Work[]         @relation("WorkCreatedByUser")
  worksDeleted         Work[]         @relation("WorkDeletedByUser")
  servicesDeleted      Service[]      @relation("ServiceDeletedByUser")
  paymentsCreated      Payment[]      @relation("PaymentCreatedByUser")
  paymentsDeleted      Payment[]      @relation("PaymentDeletedByUser")
  backupLogs           BackupLog[]

  @@map("users")
}
