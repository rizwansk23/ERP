// ============================================================================
// 5. WORKS
// finalAmount = charge - discountAmount
// NOTE on computed column: see prisma/schema/README.md — "Generated / computed
// columns" section — for why this is a plain writable Float here rather than
// a native SQLite GENERATED ALWAYS AS (...) STORED column.
// NOTE on status: Prisma's SQLite connector does not support `enum` blocks,
// so `status` is a plain String — see README "Enums on SQLite".
// Valid values for `status`: "PENDING" | "ACCEPTED" | "REJECTED"
// ============================================================================

model Work {
  id                    Int      @id @default(autoincrement())
  customerId            Int      @map("customer_id")
  customer              Customer @relation(fields: [customerId], references: [id])
  serviceId             Int      @map("service_id")
  service               Service  @relation(fields: [serviceId], references: [id])
  acknowledgementNumber String   @unique @map("acknowledgement_number")
  reference             String?
  workDate              DateTime @map("work_date")
  deadline              DateTime?
  remark                String?

  charge         Float
  discountAmount Float @default(0) @map("discount_amount")
  // Computed at the application layer on create/update: charge - discountAmount.
  finalAmount    Float @default(0) @map("final_amount")

  processed Boolean @default(false)
  status    String  @default("PENDING")
  completed Boolean @default(false)
  delivered Boolean @default(false)

  createdById Int      @map("created_by")
  createdBy   User     @relation("WorkCreatedByUser", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById Int?      @map("deleted_by")
  deletedBy   User?     @relation("WorkDeletedByUser", fields: [deletedById], references: [id])

  payments Payment[]

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@map("works")
}
