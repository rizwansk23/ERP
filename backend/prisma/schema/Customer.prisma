// ============================================================================
// 4. CUSTOMERS
// Uniqueness rule: (name + surname) must be unique across customers.
// Phone is NOT unique on its own — a family may share a number.
// ============================================================================

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  surname   String
  phone     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById Int?      @map("deleted_by")
  deletedBy   User?     @relation("CustomerDeletedByUser", fields: [deletedById], references: [id])

  works Work[]

  @@unique([name, surname])
  @@map("customers")
}